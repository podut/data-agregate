# Configurări Generale
IS_DOCKER=true
USE_MYSQL=false
USE_POSTGRES=true

# Postgres Config
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=data_agregate

# Redis Config
REDIS_HOST=redis
REDIS_PORT=6379

# Baza de Date MySQL (pentru conexiunea din backend - de rezerva)
MYSQL_HOST=db
MYSQL_DATABASE=data_agregate
MYSQL_USER=user_agregate
MYSQL_PASSWORD=your_password_here
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=your_root_password_here

# Chei API AI (completează-le cu cheile tale reale)
# AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
SERP_API_KEY=your_serp_api_key_here

# Scheduler (ora la care se face digest-ul automat)
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=0

ALLOWED_ORIGINS=*
API_HOST=0.0.0.0
